# Netlify custom headers for visualsbyjoshua.com
# Security headers apply sitewide; caching is tuned per asset class below.
# HTML is deliberately left on Netlify's default (max-age=0, must-revalidate)
# so content and schema edits go live immediately.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:;
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Build-pipeline derivatives. These are regenerated from sources rather than
# edited in place, so a long immutable lifetime is safe and gives repeat
# visitors and Core Web Vitals field data the full benefit.
/images/optimized/*
  Cache-Control: public, max-age=31536000, immutable

# Hand-placed images. 30 days rather than a year on purpose: these filenames are
# not content-hashed, so replacing a photo while keeping its name would
# otherwise leave returning visitors on the old file for a year.
/images/*
  Cache-Control: public, max-age=2592000
/newblogimages/*
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.avif
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000

# Stylesheets and scripts: a week, with a day of stale-while-revalidate so a
# deploy never blocks a render on a fresh fetch.
/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Crawler-facing files should be re-read often.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
